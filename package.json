{
  "name": "emotion-context",
  "version": "0.1.0",
  "type": "module",
  "description": "Browser extension that analyzes draft message emotional tone and appends formatting hints to optimize AI responses without triggering sycophancy.",
  "license": "MIT",
  "author": "muhammed thajudheen",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "browser-extension",
    "manifest-v3",
    "ai",
    "tone-analysis",
    "anti-sycophancy"
  ],
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@types/chrome": "^0.3.7",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
